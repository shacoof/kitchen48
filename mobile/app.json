{
  "expo": {
    "name": "Kitchen48",
    "slug": "kitchen48",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kitchen48",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitchen48.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#334155"
      },
      "package": "com.kitchen48.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-asset",
      [
        "expo-notifications",
        {
          "androidMode": "default"
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#334155",
          "imageWidth": 200
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kitchen48 uses the microphone so you can control cooking mode with your voice.",
          "speechRecognitionPermission": "Kitchen48 uses speech recognition to understand voice commands like \"next\" and \"start timer\"."
        }
      ],
      "./plugins/withGradleMemory",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2061b5ec-d682-4ffa-be6e-84b95a7a8535"
      }
    },
    "owner": "shacoof",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2061b5ec-d682-4ffa-be6e-84b95a7a8535"
    }
  }
}
